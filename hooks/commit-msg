#!/bin/bash
# Dispatcher: commit-msg (git global)
# git config --global core.hooksPath "C:/Users/<massimiliano.pili>/.config/git/hooks"
#
# Runs all executable scripts in commit-msg.d/ then chains to per-repo hook.
# Own directory from $0 with parameter expansion: on Windows every process
# spawn costs hundreds of ms, $(cd "$(dirname "$0")" && pwd) costs two.

case $0 in
  */* | *\\*) HOOK_DIR="${0%[/\\]*}/commit-msg.d" ;;
  *) HOOK_DIR="./commit-msg.d" ;;
esac

if [ -d "$HOOK_DIR" ]; then
  for hook in "$HOOK_DIR"/*; do
    [ -x "$hook" ] || continue
    "$hook" "$@" || exit $?
  done
fi

# Chain to per-repo commit-msg hook
if [ -z "${CLAUDE_GLOBAL_COMMIT_MSG_RAN:-}" ]; then
  GIT_DIR_ABS="$(git rev-parse --absolute-git-dir 2>/dev/null)"
  if [ -n "$GIT_DIR_ABS" ]; then
    LOCAL_HOOK="$GIT_DIR_ABS/hooks/commit-msg"
    if [ -x "$LOCAL_HOOK" ]; then
      export CLAUDE_GLOBAL_COMMIT_MSG_RAN=1
      exec "$LOCAL_HOOK" "$@"
    fi
  fi
fi

exit 0
