#!/bin/bash
# Dispatcher: pre-commit (git global)
# git config --global core.hooksPath "C:/Users/<massimiliano.pili>/.config/git/hooks"
#
# Runs all executable scripts in pre-commit.d/ then chains to per-repo hook.
# Own directory from $0 with parameter expansion: on Windows every process
# spawn costs hundreds of ms, $(cd "$(dirname "$0")" && pwd) costs two.

case $0 in
  */* | *\\*) HOOK_DIR="${0%[/\\]*}/pre-commit.d" ;;
  *) HOOK_DIR="./pre-commit.d" ;;
esac

if [ -d "$HOOK_DIR" ]; then
  for hook in "$HOOK_DIR"/*; do
    [ -x "$hook" ] || continue
    "$hook" "$@" || exit $?
  done
fi

# Chain to per-repo pre-commit hook
if [ -z "${_GLOBAL_PRE_COMMIT_RAN:-}" ]; then
  GIT_DIR_ABS="$(git rev-parse --absolute-git-dir 2>/dev/null)"
  if [ -n "$GIT_DIR_ABS" ]; then
    LOCAL_HOOK="$GIT_DIR_ABS/hooks/pre-commit"
    if [ -x "$LOCAL_HOOK" ]; then
      export _GLOBAL_PRE_COMMIT_RAN=1
      exec "$LOCAL_HOOK" "$@"
    fi
  fi
fi

exit 0
